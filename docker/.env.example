# ============================================================
# docker/.env.example
#
# 复制为 docker/.env 后按实际环境修改：
#   cp .env.example .env
#
# docker/.env 已 gitignore，禁止提交真实密码/密钥。
# 下方密码与会话密钥均为示例值 123456，生产环境必须全部替换；
# 随机密钥可用 openssl rand -hex 32 生成。
# 完整变量说明见仓库根目录 README 与各组件 Readme。
# ============================================================

# ---------------- data stack ----------------
MYSQL_ROOT_PASSWORD=123456
REDIS_PASSWORD=123456
ELASTIC_PASSWORD=123456

# 容器内存上限；未设置时使用 compose 默认值
MYSQL_MEM_LIMIT=1g
REDIS_MEM_LIMIT=768m
REDIS_MAXMEMORY=512m
ELASTIC_MEM_LIMIT=1g
JAVA_XMS=512m
JAVA_XMX=512m

# ---------------- Docker json-file 日志轮转（所有 stack） ----------------
LOG_MAX_SIZE=50m
LOG_MAX_FILE=3

# ---------------- 挂载基础路径 ----------------
# 默认相对 docker/ 目录；数据放到 /opt/ai/data 时改为该路径
# DOCKER_VOLUME_DIRECTORY=/opt/ai/data

# ---------------- 应用 stack 内存上限 ----------------
TERMIX_MEM_LIMIT=512m
GUACD_MEM_LIMIT=256m
NEWAPI_MEM_LIMIT=512m
NGINX_MEM_LIMIT=256m

# ---------------- Termix（留空使用 SQLite） ----------------
# 启用 MySQL 时取消注释并按实际库名/用户/密码修改；URL 中的密码需 URL 编码
# TERMIX_DB_DIALECT=mysql
# TERMIX_DB_URL=mysql://termix:123456@host.docker.internal:6306/termix_data?ssl=false
# TERMIX_DB_POOL_MAX=10

# ---------------- new-api（以下三项必填） ----------------
# Go MySQL DSN，凭据不要 URL 编码；库和用户需预先创建
NEWAPI_SQL_DSN=newapi:123456@tcp(host.docker.internal:6306)/newapi?charset=utf8mb4&parseTime=True&loc=Local

# 持久化会话密钥；生产使用 openssl rand -hex 32 生成，不要沿用示例值
NEWAPI_SESSION_SECRET=123456

# Redis 固定使用 12 号逻辑库；URL 中的密码需 URL 编码（示例值无需编码）
NEWAPI_REDIS_CONN_STRING=redis://:123456@host.docker.internal:6379/12

# 可选：经 HTTPS 部署时设为 true，并同时给出精确的 HTTPS Origin
NEWAPI_SESSION_COOKIE_SECURE=false
# NEWAPI_SESSION_COOKIE_TRUSTED_URL=https://router.xcoai.net