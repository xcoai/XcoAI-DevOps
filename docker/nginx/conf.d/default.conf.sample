server {
    listen 80;
    server_name www.xxx.net;
    rewrite ^ https://$server_name$request_uri? permanent;
}
server {
    listen                     443 ssl;
    http2                      on;
    server_name                www.xxx.net;
    ssl_certificate            /etc/nginx/ssl/xxx.net/fullchain.pem;
    ssl_certificate_key        /etc/nginx/ssl/xxx.net/privkey.pem;
    ssl_trusted_certificate    /etc/nginx/ssl/xxx.net/chain.pem;
    include                    /etc/nginx/conf.d/conf_ssl;
    include                    /etc/nginx/conf.d/waf_server;
    # 部署级自定义响应头/代理参数；由 conf_custom_header.sample 复制而来
    # include                    /etc/nginx/conf.d/conf_custom_header;

    limit_req                  zone=req_site burst=60 nodelay;
    limit_conn                 conn_perip 50;

    # CORS 白名单：默认不放开跨域；按实际前端域名取消注释并修改正则
    # if ($http_origin ~* "^https://([a-z0-9-]+\.)?your-domain\.com$") {
    #     set $cors_origin $http_origin;
    # }

    location /upload/ {
        # location 级 add_header 会覆盖 server/http 级响应头，
        # 取消注释可启用自定义header相关变量
        # include /etc/nginx/conf.d/conf_custom_header;
        # 如果启用自定义header相关变量，需注释如下引用
        include /etc/nginx/conf.d/conf_header;

        add_header Content-Disposition $download_attachment;
        add_header Cache-Control $download_cache_control;

        alias /usr/share/nginx/upload/;
    }

    location ~* ^/(api|openapi)/(login|auth|logout|sms|register|password)(?![a-z0-9]) {
        limit_req zone=req_auth burst=5 nodelay;

        proxy_http_version 1.1;
        proxy_pass http://host.docker.internal:8080;
        proxy_set_header Host $proxy_hdr_host;
        proxy_set_header X-Real-IP $proxy_hdr_real_ip;
        proxy_set_header X-Forwarded-Proto $proxy_hdr_proto;
        proxy_set_header X-Forwarded-For $proxy_hdr_forwarded_for;

        # 取消注释可启用自定义header相关变量
        # include /etc/nginx/conf.d/conf_custom_header;
    }

    location ~* /(api|openapi|dataapi|proxy|websocket|socket\.io)/ {
        limit_req  zone=req_api burst=20 nodelay;

        # websocket
        proxy_http_version 1.1;
        proxy_set_header Upgrade $proxy_hdr_upgrade;
        proxy_set_header Connection $proxy_hdr_connection;

        proxy_pass http://host.docker.internal:8080;
        proxy_set_header Host $proxy_hdr_host;
        proxy_set_header X-Real-IP $proxy_hdr_real_ip;
        proxy_set_header X-Forwarded-Proto $proxy_hdr_proto;
        proxy_set_header X-Forwarded-For $proxy_hdr_forwarded_for;

        # 取消注释可启用自定义header相关变量
        # include /etc/nginx/conf.d/conf_custom_header;
    }

    location / {
        root /usr/share/nginx/site/xcloud;
    }
}

server {
  listen      80;
  server_name localhost;

  include                    /etc/nginx/conf.d/waf_server;

  location / {
      return 200 "";
  }
}