server {
    listen 80;
    server_name router.xcoai.net;
    rewrite ^ https://$server_name$request_uri? permanent;
}
server {
    listen                     443 ssl;
    http2                      on;
    server_name                router.xcoai.net;
    ssl_certificate            /etc/nginx/ssl/xcoai.net/fullchain.pem;
    ssl_certificate_key        /etc/nginx/ssl/xcoai.net/privkey.pem;
    ssl_trusted_certificate    /etc/nginx/ssl/xcoai.net/chain.pem;
    include                    /etc/nginx/conf.d/conf_ssl;
    include                    /etc/nginx/conf.d/waf_server;
    # 部署级自定义响应头/代理参数；由 conf_custom_header.sample 复制而来
    # include                    /etc/nginx/conf.d/conf_custom_header;

    limit_req                  zone=req_site burst=60 nodelay;
    limit_conn                 conn_perip 50;

    # CORS 白名单：默认不放开跨域；按实际前端域名取消注释并修改正则
    # if ($http_origin ~* "^https://([a-z0-9-]+\.)?your-domain\.com$") {
    #     set $cors_origin $http_origin;
    # }

    location = / {
        return 301 /dashboard/overview;
    }

    location ~ ^/(api|v1beta|v1|pg|kling|jimeng|mj)/ {
        limit_req zone=req_api burst=20 nodelay;

        # websocket
        proxy_http_version 1.1;
        proxy_set_header Upgrade $proxy_hdr_upgrade;
        proxy_set_header Connection $proxy_hdr_connection;

        proxy_pass http://host.docker.internal:9960;
        proxy_set_header Host $proxy_hdr_host;
        proxy_set_header X-Real-IP $proxy_hdr_real_ip;
        proxy_set_header X-Forwarded-Proto $proxy_hdr_proto;
        proxy_set_header X-Forwarded-For $proxy_hdr_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 300s;
        proxy_read_timeout 5400s;
        proxy_send_timeout 5400s;
    }

    location / {
        proxy_pass http://host.docker.internal:9960;
        proxy_set_header Host $proxy_hdr_host;
        proxy_set_header X-Real-IP $proxy_hdr_real_ip;
        proxy_set_header X-Forwarded-Proto $proxy_hdr_proto;
        proxy_set_header X-Forwarded-For $proxy_hdr_forwarded_for;

        # 取消注释可启用自定义header相关变量
        # include /etc/nginx/conf.d/conf_custom_header;
    }
}