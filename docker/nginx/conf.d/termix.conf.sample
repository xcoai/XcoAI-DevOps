server {
    listen 80;
    server_name remote.xcoai.net;
    rewrite ^ https://$server_name$request_uri? permanent;

    location ~ /.well-known/acme-challenge/ {
        allow all;
    }
}
server {
    listen                     443 ssl;
    server_name                remote.xcoai.net;
    ssl_certificate            /etc/nginx/ssl/xcoai.net/fullchain.pem;
    ssl_certificate_key        /etc/nginx/ssl/xcoai.net/privkey.pem;
    ssl_trusted_certificate    /etc/nginx/ssl/xcoai.net/chain.pem;
    include                    /etc/nginx/conf.d/conf_ssl;
    include                    /etc/nginx/conf.d/conf_xss-sql;

    location / {
        if ($request_filename ~* ^.*?.(txt|doc|pdf|rar|gz|zip|docx|exe|xlsx|ppt|pptx)$){
            add_header Content-Disposition attachment;
        }
        # websocket
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_pass http://172.17.0.1:9980;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}