server {
    listen 80;
    server_name remote.xcoai.net;
    rewrite ^ https://$server_name$request_uri? permanent;

    location ~ /.well-known/acme-challenge/ {
        allow all;
    }
}
server {
    listen                     443 ssl;
    server_name                remote.xcoai.net;
    ssl_certificate            /etc/nginx/ssl/xcoai.net/fullchain.pem;
    ssl_certificate_key        /etc/nginx/ssl/xcoai.net/privkey.pem;
    ssl_trusted_certificate    /etc/nginx/ssl/xcoai.net/chain.pem;
    include                    /etc/nginx/conf.d/conf_ssl;
    # termix 的文件管理/终端请求会携带 /etc/passwd、../ 等合法路径参数，
    # 全量 WAF 会误拦，改用精简规则（仅 UA/Referer/方法）
    include                    /etc/nginx/conf.d/waf_server_lite;

    limit_req                  zone=req_site burst=60 nodelay;
    limit_conn                 conn_perip 50;

    # CORS 白名单：默认不放开跨域；按实际前端域名取消注释并修改正则
    # if ($http_origin ~* "^https://([a-z0-9-]+\.)?your-domain\.com$") {
    #     set $cors_origin $http_origin;
    # }

    location / {
        limit_req  zone=req_api burst=20 nodelay;

        if ($request_filename ~* ^.*?.(txt|doc|pdf|rar|gz|zip|docx|exe|xlsx|ppt|pptx)$) {
            add_header Content-Disposition attachment;
        }
        # websocket
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_pass http://host.docker.internal:9980;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}