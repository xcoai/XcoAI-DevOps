# 部署级覆盖（可选）：复制 conf_custom_header.sample 为 conf_custom_header 并启用站点 include，在其内用 set
# 覆盖 $proxy_hdr_*（见 conf_map）或直接写 proxy_* 标量；不要把本文件 include 到
# location（会用这里的请求头数组整体替换 location 自己的 proxy_set_header）。
client_max_body_size        100m;
client_body_buffer_size     1024k;
client_header_buffer_size   512k;

proxy_set_header            Accept-Encoding "";
proxy_set_header            Host $host:$server_port;
proxy_set_header            REMOTE-HOST $remote_addr;
proxy_set_header            X-Real-IP $remote_addr;
proxy_set_header            X-Real-PORT $remote_port;
proxy_set_header            X-Forwarded-Host $host;
proxy_set_header            X-Forwarded-Server $host;
proxy_set_header            X-Forwarded-Proto $scheme;
proxy_set_header            X-Forwarded-For $proxy_add_x_forwarded_for;

proxy_connect_timeout       360;
proxy_send_timeout          240;
proxy_read_timeout          240;
proxy_buffering             on;
proxy_buffer_size           512k;
proxy_buffers               16 256k;
proxy_busy_buffers_size     512k;
proxy_headers_hash_max_size 51200;
proxy_headers_hash_bucket_size 6400;
proxy_temp_file_write_size  512k;
proxy_next_upstream error   timeout invalid_header http_500 http_503 http_404;
proxy_max_temp_file_size    128m;
# default value is off, it support nginx error_page.
#proxy_intercept_errors      on;