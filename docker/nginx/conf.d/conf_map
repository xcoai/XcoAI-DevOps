map $request_uri $loggable_uri {
    ~^.*/websocket/.*$  0;
    default 1;
}
map $status $loggable_status {
    ~^[23]  0;
    default $loggable_uri;
}
map $http_upgrade $connection_upgrade {
    ''      close;
    default upgrade;
}
